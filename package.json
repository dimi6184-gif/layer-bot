{
  "name": "layer-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Discord bot for Layer",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsc",
    "postbuild": "node scripts/add-js-extensions.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "postinstall": "prisma generate && npm run build",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.7.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.14.0",
    "@types/express": "^5.0.6",
    "axios": "^1.16.1",
    "canvas": "^3.2.3",
    "discord-transcript-v2": "^1.0.16",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "fast-levenshtein": "^2.0.6",
    "ffmpeg-static": "^5.3.0",
    "follow-redirects": "^1.16.1",
    "opusscript": "^0.0.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5"
  }
}
