# Discord application
DISCORD_TOKEN="your_discord_bot_token"
CLIENT_ID="your_discord_client_id"
# Optional comma-separated guild IDs for instant slash-command updates
DEV_GUILD_ID="your_test_server_id"

# PostgreSQL database used by Prisma
DATABASE_URL="postgresql://user:password@host:5432/database"

# AI providers
GEMINI_API_KEY="your_gemini_api_key"
HUGGINGFACE_API_KEY="your_huggingface_api_key"

# Twitch API (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID="your_twitch_client_id"
TWITCH_CLIENT_SECRET="your_twitch_client_secret"

# YouTube API (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY="your_youtube_api_key"

# HTTP API used by the dashboard
BOT_API_SECRET="a_long_random_secret"
MONITOR_API_SECRET="a_different_long_random_secret"
BOT_API_PORT="3001"

# Public web app used for verification and ban-appeal links
WEB_APP_URL="https://www.uselayer.de"
NEXTAUTH_URL="https://www.uselayer.de"

# Optional status-page heartbeat
STATUS_HEARTBEAT_URL="https://status.uselayer.de/api/heartbeat/layer-bot"
STATUS_HEARTBEAT_TOKEN="the_heartbeat_token"

# Optional Upcore push monitor
UPCORE_PUSH_URL="https://example.com/push/your-token"

# Encryption key for fingerprint data (64 hex chars or 32-byte base64)
FINGERPRINT_ENCRYPTION_KEY="replace_with_a_32_byte_key"

# Optional AI rate limits
AI_GUILD_HOURLY_LIMIT="120"
AI_USER_HOURLY_LIMIT="20"
